{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/image-production-plan-v1.json",
  "title": "Image production plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "prompt_revision_id", "candidates", "evaluation", "final_request"],
  "properties": {
    "schema": {"const": "image-production-plan/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "prompt_revision_id": {"type": "string", "minLength": 1},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 8},
    "evaluation": {"type": "object"},
    "final_request": {"type": ["object", "null"]}
  }
}
